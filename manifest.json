
{
  "manifest_version": 3,
  "name": "ChatGPT Bulk Delete",
  "version": "1.1.0",
  "description": "Selecione várias conversas do ChatGPT para excluir em lote.",

  "icons": {
    "16": "assets/images/icon-16.png",
    "48": "assets/images/icon-48.png",
    "128": "assets/images/icon-128.png"
  },

  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/audiowide-regular.woff2"],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "dist/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
